# Empty means same origin. Requests go to /api on the Vite dev server, which
# proxies them to the API — so there is no CORS and no port to get wrong.
VITE_API_BASE_URL=

# Where the proxy forwards to. Server-side only; never reaches the browser.
# Change this if the API prints a different port when it starts.
API_PROXY_TARGET=http://localhost:5001
