# Copy to .env.local and adjust. Vite inlines these into the bundle, so nothing
# secret belongs here — the API holds the signing key and the database.

# Where the API is. Leave blank for same-origin behind a reverse proxy.
VITE_API_BASE_URL=https://localhost:7001

# true  = built-in mock data, no backend needed
# false = talk to the API above
VITE_USE_MOCKS=false
